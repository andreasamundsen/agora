{
  "name": "agora",
  "private": true,
  "version": "0.1.52",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Andreas Amundsen",
  "license": "UNLICENSED",
  "description": "A debate harness: map a debate as a structured graph, export it as Argdown, and stage it as an animated exchange.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts",
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "tsx src/server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron": "electron .",
    "pack": "npm run build && npm run build:server && electron-builder --dir",
    "dist": "npm run build && npm run build:server && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@argdown/core": "^2.0.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "build": {
    "appId": "com.agora.debate",
    "productName": "Agora",
    "copyright": "Andreas Amundsen",
    "asar": true,
    "publish": null,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "electron/server.cjs",
        "to": "server/server.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Agora-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
